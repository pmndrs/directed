{
  "name": "directed",
  "version": "0.1.6",
  "description": "📅 A flexible, minimal scheduler written in TypeScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pmndrs/directed"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "import": "./src/react.ts"
    }
  },
  "files": [
    "dist",
    "react",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.cts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./react": {
        "types": "./dist/react.d.cts",
        "import": "./dist/react.js",
        "require": "./dist/react.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown && node --no-warnings scripts/copy-readme.ts"
  },
  "devDependencies": {
    "@config/typescript": "workspace:*",
    "@directed/core": "workspace:*",
    "@directed/react": "workspace:*",
    "react": ">=18.0.0",
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "@types/react": ">=18.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
