{
  "name": "root",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "ship": "pnpm -F directed build && pnpm -F directed publish",
    "prepublish": "pnpm -F directed build",
    "app": "pnpm -F scheduler-test dev",
    "dev": "pnpm --filter './apps/*' run dev",
    "build": "pnpm --filter './packages/*' run build && pnpm --filter './apps/*' run build",
    "test": "pnpm -r run test",
    "lint": "oxlint .",
    "format": "prettier --config .config/prettier/base.json --ignore-path .config/prettier/prettierignore --write ."
  },
  "dependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6"
  },
  "engines": {
    "pnpm": ">=11.0.0",
    "node": ">=22.13"
  }
}
